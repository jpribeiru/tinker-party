--- !u!114 &1430425658
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1430425656}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "// This is the required uno code to upload before running game, also on
    the github repo.\n\n// defines the pin locations\nconst int potPin1 = A1; //potentiometer
    pins, player1 = analog 1, player2 = analog 2\nconst int potPin2 = A2;\n#define
    butPin1 2 // buttons = digital pins, D2/D3 = P1/P2\n#define butPin2 3\n\nvoid
    setup() {\n  Serial.begin(115200); // opens serial port to send readigns to,
    this is main method of communication with unity\n  pinMode(potPin1, INPUT); //defines
    all of them as input\n  pinMode(potPin2, INPUT);\n  pinMode(butPin1, INPUT);\n 
    pinMode(butPin2, INPUT);\n}\n\nvoid loop() {\n  int readValue1 = analogRead(potPin1);
    //retreives values and prints\n  int readValue2 = analogRead(potPin2);\n  Serial.println(\"1:\"
    + String(readValue1)); //i use 1: and 2: etc, so when reading checks the first
    integer to see what it is. e.g 1 means player 1 potentiometer, etc\n  Serial.println(\"2:\"
    + String(readValue2));\n  int readValue3 = digitalRead(butPin1);\n  int readValue4
    = digitalRead(butPin2);\n  Serial.println(\"3:\" + String(readValue3));\n  Serial.println(\"4:\"
    + String(readValue4));\n  delay(20); // small delay to prevent lag with overflow\n 
    }\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
